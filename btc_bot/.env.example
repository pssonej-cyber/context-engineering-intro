# ─── Bitkub Exchange Credentials ──────────────────────
# Get these from https://www.bitkub.com/api (KYC required)
# Leave blank for backtest / dry-run modes.
BITKUB_API_KEY=
BITKUB_API_SECRET=
BITKUB_HOST=https://api.bitkub.com

# ─── Risk Management ──────────────────────────────────
RISK_PER_TRADE_PCT=2.0          # % of capital risked per trade
MAX_OPEN_TRADES=2               # max simultaneous positions
DAILY_LOSS_LIMIT_PCT=3.0        # halt trading after this daily loss
MAX_PORTFOLIO_HEAT_PCT=6.0      # max % of capital deployed across all trades
COOLDOWN_AFTER_LOSSES=3         # consecutive losses before cooldown
COOLDOWN_HOURS=6                # cooldown duration
MIN_POSITION_THB=500.0          # Bitkub minimum order size

# ─── Strategy Parameters (validated by backtest_v8) ───
ZONE_WIDTH_PCT=3.0              # zone size as % of price
ZONE_LOOKBACK=30                # candle window for zone detection
SWING_LOOKBACK_LEFT=3           # left bars for swing detection (4H)
SWING_LOOKBACK_RIGHT=3          # right bars for swing detection (4H)
SWING_LOOKBACK_1H=2             # left+right bars for 1H swing detection
RETEST_PROXIMITY_PCT=1.0        # "at zone" threshold (v8 tuned: 1.0%)
MIN_BOS_STRENGTH_PCT=0.3        # minimum BoS move
MIN_ZONE_SIZE_PCT=0.3           # smallest allowable zone
MAX_ZONE_AGE_BARS=100           # ignore zones older than N bars
ZONE_PADDING_PCT=0.2            # expand zone edges by this %
REJECTION_MIN_WICK_RATIO=1.5    # wick must be ≥ 1.5x body for pin bar
REJECTION_MIN_BODY_PCT=0.4      # engulfing body must be ≥ 0.4% of price
STRUCTURE_FILTER=trend_only     # "trend_only" | "any"

# ─── Exit Parameters ──────────────────────────────────
TRAILING_STOP_PCT=1.0           # trailing stop after partial TP
TP1_RR_RATIO=2.0                # TP1 at 2:1 risk-reward
TP2_RR_RATIO=4.0                # TP2 at 4:1 risk-reward
PARTIAL_EXIT_PCT=50.0           # % of position to exit at TP1
MAX_HOLD_HOURS=96               # 4 days max hold

# ─── Storage ──────────────────────────────────────────
STATE_DIR=~/.btcbot
