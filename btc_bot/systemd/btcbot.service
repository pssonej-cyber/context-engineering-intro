[Unit]
Description=BTC Trading Bot — analysis cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/home/%i/btcbot
EnvironmentFile=/home/%i/btcbot/.env
ExecStart=/home/%i/btcbot/.venv/bin/python -m btc_bot live

# Resource limits
MemoryMax=256M
CPUQuota=50%

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.btcbot
PrivateTmp=true

# On failure, log and don't retry — the timer will fire again in 15 min
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
