[Unit]
Description=BTC Trading Bot — every 15 minutes
Requires=btcbot.service

[Timer]
# Fire at :00, :15, :30, :45 of every hour
OnCalendar=*:0/15
# If the system was off, run on next boot
Persistent=true
# Spread invocations by up to 30s to avoid exact-minute API spikes
RandomizedDelaySec=30s
Unit=btcbot.service

[Install]
WantedBy=timers.target
